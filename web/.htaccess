# ══════════════════════════════════════════════════════════════
# RedesiaNet · configuración del servidor (Hostinger / LiteSpeed)
# ══════════════════════════════════════════════════════════════

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# ── HTTPS y dominio sin www ────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # /index.html → /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [L,R=301]

  # URLs de la web anterior (ya indexadas): llevan a su equivalente nuevo
  RewriteRule ^legal/aviso-legal/?$ /aviso-legal.html [R=301,L]
  RewriteRule ^legal/privacidad/?$ /privacidad.html [R=301,L]
  RewriteRule ^legal/cookies/?$ /cookies.html [R=301,L]
  RewriteRule ^servicios/.+$ /servicios.html [R=301,L]
  RewriteRule ^servicios/$ /servicios.html [R=301,L]
  RewriteRule ^contacto/?$ /contacto.html [R=301,L]
  RewriteRule ^quienes-somos/?$ /metodo.html [R=301,L]

  # nada de ficheros ocultos (.git, .env…) ni de la carpeta privada de la API
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^api/private(/|$) - [F,L]
</IfModule>

# ── Cabeceras de seguridad ─────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Si añades scripts de terceros, amplía esta política (los dominios de Meta ya están
  # permitidos para cuando actives el Pixel en js/config.js).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.facebook.com; font-src 'self'; media-src 'self'; connect-src 'self' https://www.facebook.com https://connect.facebook.net; frame-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# ── Tipos MIME ─────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/x-icon .ico
</IfModule>

# ── Compresión ─────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ── Caché: HTML siempre fresco; CSS/JS llevan ?v= en la URL ────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType video/webm "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
